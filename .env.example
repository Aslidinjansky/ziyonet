# Copy this file to .env and fill in your values
# cp .env.example .env

# Gemini API key for frontend gate (Vite client)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API key for backend route /api/chat (Vercel/server)
GEMINI_API_KEY=your_gemini_api_key_here

# On Vercel: add this as an Environment Variable in Project Settings
# https://vercel.com/docs/projects/environment-variables
